# Không bắt buộc khi chạy backend local ở https://localhost:7144 — Vite dev server
# đã tự proxy "/api" sang backend đó (xem server.proxy trong vite.config.js).
# Chỉ set biến này khi cần trỏ thẳng tới một backend khác (staging/prod, port khác...).
# VITE_API_BASE_URL=https://api.localmate.ai/api

# Public Google OAuth Web Client ID. Authorize the exact FE origin in Google Cloud.
# VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
